#!/usr/bin/env python3
"""Universal Orchestrator Kit launcher (kit 1.0.0).

  python3 UNIVERSAL-ORCHESTRATOR-KIT/uok init [--host auto|claude-code|qoder|cursor|codex|dsh]
          [--project DIR] [--mode standard|strict] [--models tier1=..,tier2=..,tier3=..,review=..]
          [--graphify auto|install|off] [--dry-run]
  python3 UNIVERSAL-ORCHESTRATOR-KIT/uok bootstrap [--host auto|all|claude-code|qoder|cursor|codex]
          [--dry-run]
  python3 UNIVERSAL-ORCHESTRATOR-KIT/uok refresh [--dry-run]
  python3 UNIVERSAL-ORCHESTRATOR-KIT/uok stats [--project DIR] [--json]

init      Primary installation: dispatches to adapters/<host>/install.py (additive,
          idempotent, backups). --project defaults to the current directory.
refresh   Re-applies the kit to every project recorded by `init` (~/.uok/projects.json),
          with the mode and models each project was installed with. `updater.sh` calls it
          after a successful update, so projects follow the single kit folder.
stats     Per-project statistics derived only from what the kit actually recorded: G1
          safety decisions (audit log), context-graph state and freshness, ledgers, the
          project registry. Honest about what is not measured (CG-07). Offline, stdlib.

Every command also proposes updates when a newer release tag exists in the publish
repo (throttled to one check per 24 h, cached in ~/.uok/update-check.json, fail-open
offline; the proposal goes to stderr and is repeated until you update). Control:
UOK_REPO=<url> overrides the repo, UOK_UPDATE_CHECK_HOURS=<n> the interval,
UOK_UPDATE_CHECK=off disables. The kit never auto-updates: refresh rewrites projects,
so updating is always a human decision (bash <kit>/updater.sh).
bootstrap One-time per machine: registers a user-level `uok-init` skill so that typing
          `uok init` (or /uok-init; Codex: $uok-init) in ANY project session runs init.
          Global skill locations [verified_doc 2026-11-17]: ~/.claude/skills,
          ~/.qoder/skills, ~/.cursor/skills, ~/.agents/skills (see adapter PROFILE.yaml).
          When ~/.dsh exists (DeepSeek Harness), the uok-init and uok launcher skills are
          mirrored into ~/.dsh/skills — DSH loads user skills only from there.
          User-authored skills are never overwritten; kit-managed ones are backed up to
          ~/.uok/backups/<timestamp>/ before update.

Host auto-detection is a heuristic (environment-variable prefixes, then project config
dirs, then home config dirs); it is a convenience for terminal use only — the session
skill always passes --host explicitly. Requires Python >= 3.10; init additionally needs
PyYAML (used by the adapter installers).
"""
import argparse
import datetime
import importlib.util
import json
import os
import re
import shutil
import subprocess
import sys
import time

KIT = os.path.dirname(os.path.realpath(__file__))
try:   # single source of truth: the VERSION file (release), not a hardcoded literal
    KIT_VERSION = open(os.path.join(KIT, "VERSION"), encoding="utf-8").read().strip() or "unknown"
except OSError:
    KIT_VERSION = "unknown"


def release_version():
    try:
        with open(os.path.join(KIT, "VERSION"), encoding="utf-8") as f:
            return f.read().strip() or "unknown"
    except OSError:
        return "unknown"


HOSTS = ("claude-code", "qoder", "cursor", "codex")
# DSH (DeepSeek Harness) has no dedicated adapter: its sessions read CLAUDE.md and
# .claude/agents, i.e. the claude-code layout — so `--host dsh` installs exactly that.
ADAPTER_ALIAS = {"dsh": "claude-code"}
BOOT_MARK = "(Universal Orchestrator Kit bootstrap)"
GLOBAL_SKILL_DIR = {"claude-code": ".claude/skills", "qoder": ".qoder/skills",
                    "cursor": ".cursor/skills", "codex": ".agents/skills"}
PROJECT_DIR_MARKER = {"claude-code": ".claude", "qoder": ".qoder", "cursor": ".cursor", "codex": ".codex"}
HOME_MARKER = {"claude-code": ".claude", "qoder": ".qoder", "cursor": ".cursor", "codex": ".codex"}
ENV_PREFIX = {"claude-code": "CLAUDE", "qoder": "QODER", "cursor": "CURSOR", "codex": "CODEX"}
INIT_INVOKE = {"claude-code": "/uok-init", "qoder": "/uok-init", "cursor": "/uok-init", "codex": "$uok-init",
               "dsh": "/uok-init"}
LAUNCH_INVOKE = {"claude-code": "/uok", "qoder": "/uok", "cursor": "/uok", "codex": "$uok",
                 "dsh": "/uok"}


def detect_host(project):
    """Heuristic: first tier (env, project dirs, home dirs) with exactly one candidate."""
    tiers = [
        [h for h in HOSTS if any(k.startswith(ENV_PREFIX[h]) for k in os.environ)],
        [h for h in HOSTS if os.path.isdir(os.path.join(project, PROJECT_DIR_MARKER[h]))],
        [h for h in HOSTS if os.path.isdir(os.path.expanduser("~/" + HOME_MARKER[h]))],
    ]
    for tier in tiers:
        if len(tier) == 1:
            return tier[0], None
        if len(tier) > 1:
            return None, tier
    return None, []


def resolve_host(requested, project):
    if requested != "auto":
        return requested
    host, ambiguous = detect_host(project)
    if host:
        return host
    if ambiguous:
        sys.exit(f"uok: several hosts look present ({', '.join(ambiguous)}); pass --host explicitly")
    sys.exit("uok: cannot detect the host; pass --host claude-code|qoder|cursor|codex|dsh")


POINTER = os.path.join(os.path.expanduser("~"), ".uok", "location")


# ---------- update proposal (never auto-update: refresh rewrites projects, a human decides)
PUBLISH_URL = os.environ.get("UOK_REPO", "https://github.com/hardforkman/uok.git")
CHECK_STATE = os.path.join(os.path.expanduser("~"), ".uok", "update-check.json")
CHECK_INTERVAL = int(os.environ.get("UOK_UPDATE_CHECK_HOURS", "24")) * 3600


def _semver(tag):
    try:
        return tuple(int(p) for p in tag[1:].split("."))
    except (ValueError, IndexError):
        return None


def maybe_notice_update():
    """Propose (never perform) an update: throttled git ls-remote of the publish repo,
    fail-open on any error, notice on stderr so --json output stays clean. While the
    cached result says a newer release exists, the proposal repeats without the network."""
    if os.environ.get("UOK_UPDATE_CHECK", "").lower() in ("off", "0", "no", "false"):
        return
    installed = _semver("v" + release_version())
    try:
        state = json.load(open(CHECK_STATE, encoding="utf-8"))
    except (OSError, ValueError):
        state = {}
    latest = _semver(state.get("latest") or "")
    if latest and installed and latest > installed:
        print(f"uok: update available: {state['latest'][1:]} (installed {release_version()}) — "
              f"run `bash {KIT}/updater.sh --check` to preview, `bash {KIT}/updater.sh` to update",
              file=sys.stderr)
    if time.time() - state.get("checked_at", 0) < CHECK_INTERVAL:
        return
    try:
        out = subprocess.run(["git", "ls-remote", "--tags", PUBLISH_URL, "v[0-9]*"],
                             capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.TimeoutExpired):
        return   # offline or git missing: silent, fail-open
    tags = [m for t in out.splitlines() if (m := _semver(t.rsplit("/", 1)[-1]))]
    if not tags:
        return
    latest_tag = "v" + ".".join(str(p) for p in max(tags))
    try:
        os.makedirs(os.path.dirname(CHECK_STATE), exist_ok=True)
        json.dump({"checked_at": time.time(), "latest": latest_tag}, open(CHECK_STATE, "w", encoding="utf-8"))
    except OSError:
        pass
    if installed and max(tags) > installed:
        print(f"uok: update available: {latest_tag[1:]} (installed {release_version()}) — "
              f"run `bash {KIT}/updater.sh --check` to preview, `bash {KIT}/updater.sh` to update",
              file=sys.stderr)


def write_pointer():
    os.makedirs(os.path.dirname(POINTER), exist_ok=True)
    with open(POINTER, "w", encoding="utf-8") as f:
        f.write(KIT + "\n")


def cmd_locate(a):
    write_pointer()
    print(f"uok locate: kit = {KIT} (recorded in {POINTER})")
    return 0


REGISTRY = os.path.join(os.path.expanduser("~"), ".uok", "projects.json")


def load_registry():
    try:
        with open(REGISTRY, encoding="utf-8") as f:
            data = json.load(f)
        return [e for e in data.get("projects", []) if isinstance(e, dict)]
    except (OSError, ValueError):
        return []


def save_registry(entries):
    os.makedirs(os.path.dirname(REGISTRY), exist_ok=True)
    with open(REGISTRY, "w", encoding="utf-8") as f:
        json.dump({"projects": entries}, f, indent=2)
        f.write("\n")


def record_project(project, host, mode, models, graphify="auto"):
    entries = [e for e in load_registry() if (e.get("project"), e.get("host")) != (project, host)]
    entries.append({"project": project, "host": host, "mode": mode, "models": models, "graphify": graphify})
    save_registry(entries)


def run_installer(project, host, mode, models, dry_run, graphify="auto"):
    adapter = ADAPTER_ALIAS.get(host, host)   # dsh -> claude-code layout (DSH reads CLAUDE.md)
    installer = os.path.join(KIT, "adapters", adapter, "install.py")
    cmd = [sys.executable, installer, "--project", project, "--mode", mode, "--graphify", graphify]
    if models:
        cmd += ["--models", models]
    if dry_run:
        cmd.append("--dry-run")
    return subprocess.call(cmd)


def cmd_init(a):
    project = os.path.realpath(a.project or os.getcwd())
    if not os.path.isdir(project):
        sys.exit(f"uok: project directory not found: {project}")
    host = resolve_host(a.host, project)
    models = a.models
    if not models:
        prev = next((e for e in load_registry()
                     if (e.get("project"), e.get("host")) == (project, host)), None)
        if prev and prev.get("models"):
            models = prev["models"]
            print(f"uok init: reusing models recorded for this project: {models}")
    print(f"uok init: host={host}, project={project}, kit={KIT}")
    if not a.dry_run:
        write_pointer()
    rc = run_installer(project, host, a.mode, models, a.dry_run, a.graphify)
    if rc == 0 and not a.dry_run:
        record_project(project, host, a.mode, models, a.graphify)
    return rc


def cmd_refresh(a):
    entries = load_registry()
    if not entries:
        print(f"uok refresh: no projects recorded in {REGISTRY}; run `uok init` in a project first")
        return 0
    write_pointer() if not a.dry_run else None
    failed, done = [], 0
    for e in entries:
        project, host = e.get("project", ""), e.get("host", "")
        if (host not in HOSTS and host not in ADAPTER_ALIAS) or not os.path.isdir(project):
            print(f"uok refresh: skipping {project or '?'} ({host or '?'}): project missing or host unknown")
            continue
        print(f"uok refresh: {host} -> {project}")
        if run_installer(project, host, e.get("mode", "standard"), e.get("models", ""), a.dry_run,
                         e.get("graphify", "auto")) != 0:
            failed.append(project)
        else:
            done += 1
    print(f"uok refresh: {done} project(s) refreshed, {len(failed)} failed"
          + (f": {', '.join(failed)}" if failed else "") + ("; restart each agent session." if done and not a.dry_run else ""))
    return 1 if failed else 0


def skill_text(host):
    return f"""---
name: uok-init
description: "Install the Universal Orchestrator Kit into the current project {BOOT_MARK}. Use when the user types 'uok init' or {INIT_INVOKE[host]}, or asks to install or set up the orchestrator kit in this project."
---

Install the Universal Orchestrator Kit (kit {KIT_VERSION}) into THIS project for **{host}**.
The kit folder is recorded in `~/.uok/location` (read it with `cat ~/.uok/location`). If that
path no longer exists, ask the user where the kit lives now and tell them to run `uok locate` from there.
Requires Python >= 3.10 with PyYAML: if the default `python3` lacks it (`import yaml` fails),
run `pip3 install --user pyyaml` first, or invoke the commands below with a project venv
interpreter that has it — never guess, check.

1. Show the plan first (use the session's current project root, quoted):
   `python3 "$(cat ~/.uok/location)/uok" init --host {host} --project "<project root>" --dry-run`
2. Install: the same command without `--dry-run`, plus `--graphify install` to also set up
   the optional Graphify context graph (fetches the `graphifyy` CLI via uv/pipx if missing -
   network, user-level, reversible; builds a code-only graph fully offline; opt out with
   `--graphify off`). It is additive and idempotent; backups go to `.orchestrator/backups/`.
   If the user gives real model selectors for this host, pass them with
   `--models tier1=..,tier2=..,tier3=..,review=..` (defaults are unverified).
   Graphify rules and live checks: the kit's core/CONTEXT-GRAPH.md.
3. Report the installer's changes and verification output honestly; never claim live
   checks that did not run.
4. Tell the user to restart the session. Afterwards tasks run through the kit via
   `{LAUNCH_INVOKE[host]} <task>` (see the kit's USAGE-GUIDE.md §6).

Do not modify user-authored agents, skills or hooks — the installer preserves them.
Do not perform sensitive operations (deploys, credential changes, publication).
"""


def dsh_orchestrator_skill_text():
    """User-level `/uok` launcher for DeepSeek Harness sessions (loaded from ~/.dsh/skills)."""
    return f"""---
name: uok
description: "Launch Universal Orchestrator Kit orchestration in this project {BOOT_MARK}. Use when the user types '/uok <task>' or asks to route or execute a task through the orchestrator kit."
---

Run Universal Orchestrator Kit orchestration (kit {KIT_VERSION}) in THIS project
for the **dsh** host (DeepSeek Harness). The kit folder is recorded in
`~/.uok/location` (read it with `cat ~/.uok/location`).

0. If the kit is not installed in this project (no adapter settings under
   `.orchestrator/policy/`), run the `/uok-init` flow first (dry-run plan, then
   install; restart the session afterwards).
1. Read the adapter settings — `.orchestrator/policy/adapter.yaml`, or
   `claude-code.yaml` when the claude-code adapter installed the kit (the G1 guard
   reads both names) — for kit_version, context_graph and host, plus the project's
   CLAUDE.md / AGENTS.md: the marked UOK rules section is the routing and quality
   policy for this session.
2. Classify the task (`core/TASK-CLASSIFICATION.md`), pick the cheapest sufficient tier
   (`core/routing-policy.yaml`; when `.orchestrator/policy/graphify.yaml` has
   `enabled: true`, the formal graph_impact modifier applies, CG-06), delegate to
   `uok-*` role agents using their role prompts (`.claude/agents/uok-*.md` or the
   adapter's agents dir), and follow `core/EXECUTION-LIFECYCLE.md`.
   Built-in exception — if the task text starts with `stats` (aliases `stat`,
   `statistics`): run `python3 "$(cat ~/.uok/location)/uok" stats --project "<project
   root>"` and present the result in the chat as a clean, readable report — the G1
   safety numbers (decisions, denies by cause, approvals that waited for a human), the
   context-graph state and freshness, the ledger counts, and the "not measured" lines
   verbatim. Do not dispatch workers for this; do not paste raw command output or JSON
   unless the user asks.
3. DSH runs NO PreToolUse G1 hook. Enforce the same boundaries explicitly: before a
   worker step, check the intended tool call against the kit's G1 logic
   (`python3 -I "$(cat ~/.uok/location)/adapters/shared/hooks/g1_guard.py" --format claude`
   with a synthetic event); never let workers write outside the project, into
   `.orchestrator/`, `.claude/`, or `graphify-out/` (CG-04); secret-bearing paths are
   always denied (SEC-02); a host approval request for wider access is legitimate —
   never bypass it.
4. Report claims only with evidence (command output); tag unverified claims honestly.
   Workers never rebuild the context graph; stale graph => main session runs
   `graphify update .` or reports `degraded_context_graph` (CG-03).

Do not perform sensitive operations (deploys, credential changes, publication).
"""


def dsh_skill_texts():
    """The user-level skills mirrored into ~/.dsh/skills when DSH is present."""
    return (("uok-init", skill_text("dsh")), ("uok", dsh_orchestrator_skill_text()))


def install_global_skill(path, text, backup_dir, changes, kept, warnings, dry):
    """Shared semantics for every user-level skill install (BOOT_MARK guard + backup)."""
    old = open(path, encoding="utf-8").read() if os.path.exists(path) else None
    if old is not None and BOOT_MARK not in old:
        kept.append(f"{path} (user-authored, not touched)")
        warnings.append(f"skill name '{os.path.basename(os.path.dirname(path))}' taken by a user skill; not installed")
        return
    if old == text:
        kept.append(f"{path} (unchanged)")
        return
    changes.append(f"{'update' if old is not None else 'create'} {path}")
    if dry:
        return
    if old is not None:
        dst = os.path.join(backup_dir, os.path.basename(os.path.dirname(path)), "SKILL.md")
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        shutil.copy2(path, dst)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        f.write(text)


def cmd_bootstrap(a):
    if not a.dry_run:
        write_pointer()
    if a.host == "all":
        hosts = list(HOSTS)
    elif a.host != "auto":
        hosts = [a.host]
    else:
        hosts = [h for h in HOSTS if os.path.isdir(os.path.expanduser("~/" + HOME_MARKER[h]))]
        if not hosts:
            sys.exit("uok: no host config dirs found in ~; pass --host explicitly or --host all")
    ts = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    backup_dir = os.path.expanduser(f"~/.uok/backups/{ts}")
    changes, kept, warnings = [], [], []
    for host in hosts:
        install_global_skill(os.path.expanduser(f"~/{GLOBAL_SKILL_DIR[host]}/uok-init/SKILL.md"),
                             skill_text(host), backup_dir, changes, kept, warnings, a.dry_run)
    dsh_dir = os.path.expanduser("~/.dsh")
    if os.path.isdir(dsh_dir):   # DeepSeek Harness installed: mirror user-level skills it auto-loads
        for name, text in dsh_skill_texts():
            install_global_skill(os.path.join(dsh_dir, "skills", name, "SKILL.md"),
                                 text, backup_dir, changes, kept, warnings, a.dry_run)
    print(f"uok bootstrap (kit {KIT_VERSION}, {'DRY RUN' if a.dry_run else 'done'}): "
          f"user-level uok-init skill for {', '.join(hosts)}")
    for title, items in (("changes", changes or ["(none)"]), ("kept", kept), ("warnings", warnings)):
        if items:
            print(f"{title}:")
            for it in items:
                print("  - " + it)
    if changes and not a.dry_run and any(c.startswith("update") for c in changes):
        print(f"backups: {backup_dir}/")
    if not a.dry_run:
        print("next: restart the agent session, open any project and type `uok init` "
              "(or /uok-init; Codex: $uok-init) to install the kit there.")
    return 0


def _scalar(path, key):
    """`key: value` from a simple policy yaml (no PyYAML dependency, same trick as g1_guard)."""
    try:
        for line in open(path, encoding="utf-8"):
            if line.lstrip().startswith("#") or ":" not in line:
                continue
            k, _, v = line.partition(":")
            if k.strip() == key:
                return v.split("#")[0].strip().strip('"')
    except OSError:
        pass
    return None


def _g1_stats(project):
    """Honest counters from the G1 hook audit log (fail-open on any error)."""
    s = {"log": "absent", "decisions": 0, "allow": 0, "deny": 0, "ask": 0, "fail_open": 0,
         "secret_paths": 0, "outside_root": 0, "guard_controls": 0, "claims": 0,
         "secret_payloads": 0, "shell_denied": 0, "approval_asks": 0, "approval_fallbacks": 0,
         "other_denies": 0, "worker_roles": 0, "worker_decisions": 0, "first": None, "last": None}
    path = os.path.join(project, ".orchestrator", "audit", "g1.log")
    if not os.path.isfile(path):
        return s
    s["log"] = "present"
    roles, rx = set(), re.compile(r"^(\S+)\s+(allow|deny|ask|fail-open):\s+\[(.*?)\]\s*(.*)$")
    try:
        for line in open(path, encoding="utf-8", errors="replace"):
            m = rx.match(line.strip())
            if not m:
                continue
            ts, dec, who, rest = m.groups()
            s["decisions"] += 1
            if dec == "fail-open":
                s["fail_open"] += 1
                continue
            s[dec] += 1
            s["first"] = s["first"] or ts
            s["last"] = ts
            parts = who.split()
            agent = parts[0] if parts else "?"
            if agent.startswith("uok-"):
                s["worker_decisions"] += 1
                roles.add(agent)
            if dec == "deny":
                if "SEC-02" in rest:
                    s["secret_paths"] += 1
                elif "ISO-02" in rest:
                    s["outside_root"] += 1
                elif "LC-04" in rest:
                    s["claims"] += 1
                elif "SEC-03" in rest:
                    s["secret_payloads"] += 1
                elif "SEC-07" in rest:
                    s["approval_fallbacks"] += 1   # host cannot ask: denied with "the human must run it"
                elif "shell_allowlist" in rest:
                    s["shell_denied"] += 1
                elif "SEC-04" in rest:
                    s["guard_controls"] += 1
                else:
                    s["other_denies"] += 1
            elif dec == "ask" and "SEC-07" in rest:
                s["approval_asks"] += 1
    except OSError:
        pass
    s["worker_roles"] = len(roles)
    return s


def _graph_stats(project):
    """Context-graph state from policy + graph.json (fail-open; one extractor for CG-03/CG-07)."""
    out = {"enabled": False}
    pol = os.path.join(project, ".orchestrator", "policy", "graphify.yaml")
    if os.path.isfile(pol):
        out["enabled"] = str(_scalar(pol, "enabled")).lower() == "true"
        for k in ("cli_version", "schema_version", "built_at", "verification", "mode", "nodes"):
            out[k] = _scalar(pol, k)
    gpath = os.path.join(project, "graphify-out", "graph.json")
    if out["enabled"] and os.path.isfile(gpath):
        spec = importlib.util.spec_from_file_location("graph_signal", os.path.join(KIT, "core", "graph_signal.py"))
        gs = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(gs)
        g = gs.load_graph(gpath)
        if g and isinstance(g.get("nodes"), list):
            nodes = g["nodes"]
            out["nodes"] = len(nodes)
            out["edges"] = len(g.get("links") or g.get("edges") or []) + len(g.get("hyperedges") or [])
            files = []
            for n in nodes[:3000]:
                f = gs._node_file(n) if isinstance(n, dict) else None
                if f:
                    files.append(f if os.path.isabs(f) else os.path.join(project, f))
            if files:
                out["fresh"] = "yes" if not gs.is_stale(gpath, files) else "no"
    return out


def _ledger_counts(project):
    orch = os.path.join(project, ".orchestrator")
    def count(sub, pred):
        d = os.path.join(orch, sub)
        return len([f for f in os.listdir(d) if pred(f)]) if os.path.isdir(d) else 0
    claims = os.path.join(orch, "claims", "active.json")
    active = 0
    if os.path.isfile(claims):
        try:
            active = len(json.load(open(claims, encoding="utf-8")).get("claims", []))
        except (OSError, ValueError):
            active = 0
    return {"routing_records": count("routing", lambda f: True),
            "task_ledger_entries": count("tasks", lambda f: True),
            "audit_notes": count("audit", lambda f: f.endswith(".md")),
            "active_claims": active}


def cmd_stats(a):
    """Per-project statistics, derived only from what the kit actually recorded."""
    project = os.path.realpath(a.project or os.getcwd())
    orch = os.path.join(project, ".orchestrator")
    if not os.path.isdir(orch):
        print(f"uok: no UOK installation found in {project} — run `uok init` there first")
        return 1
    adapter = next((os.path.join(orch, "policy", n) for n in ("adapter.yaml", "claude-code.yaml")
                    if os.path.isfile(os.path.join(orch, "policy", n))), None)
    kit = {"release": release_version()}
    for k in ("host", "enforcement", "kit_version", "context_graph"):
        kit[k] = _scalar(adapter, k) if adapter else None
    if kit["host"] is None and adapter:   # claude-code.yaml carries no host key: the filename is the host
        kit["host"] = os.path.splitext(os.path.basename(adapter))[0] if adapter.endswith("claude-code.yaml") else None
    safety, graph, ledger = _g1_stats(project), _graph_stats(project), _ledger_counts(project)
    try:
        registry = json.load(open(os.path.expanduser("~/.uok/projects.json"), encoding="utf-8"))["projects"]
    except (OSError, ValueError, KeyError):
        registry = []
    report = {
        "project": project, "kit": kit, "safety": safety, "context_graph": graph,
        "orchestration": ledger, "registry_projects": len(registry),
        "not_measured": [
            "graph-query usage: the graphify CLI keeps no query log (the CG-04 wrapper disables it)",
            "token/time savings vs a no-kit baseline: needs an A/B run, see USAGE-GUIDE.md §7",
        ],
    }
    if a.json:
        print(json.dumps(report, indent=2, ensure_ascii=False))
        return 0
    span = ""
    if safety["first"]:
        span = f" since {safety['first'][:10]}" + (f", last {safety['last'][:19]}" if safety["last"] else "")
    g = graph
    print(f"uok stats — {project}")
    print(f"  kit {kit['release']} · host {kit['host']} · enforcement {kit['enforcement']}")
    print()
    print("Safety — the G1 hook audit log (.orchestrator/audit/g1.log)")
    if safety["log"] == "absent":
        print("  no decisions recorded yet (the hook logs every allow/deny/ask once the host runs it)")
    else:
        print(f"  {safety['decisions']} decisions{span}: "
              f"{safety['allow']} allow · {safety['deny']} deny · {safety['ask']} ask"
              + (f" · {safety['fail_open']} fail-open" if safety["fail_open"] else ""))
        causes = []
        if safety["secret_paths"]: causes.append(f"{safety['secret_paths']} secret-path reads blocked (SEC-02)")
        if safety["secret_payloads"]: causes.append(f"{safety['secret_payloads']} secret-like payloads blocked (SEC-03)")
        if safety["outside_root"]: causes.append(f"{safety['outside_root']} reads/writes outside the project (ISO-02)")
        if safety["guard_controls"]: causes.append(f"{safety['guard_controls']} guard-control violations stopped (SEC-04)")
        if safety["shell_denied"]: causes.append(f"{safety['shell_denied']} non-allowlisted shell commands (SEC-04)")
        if safety["claims"]: causes.append(f"{safety['claims']} claim violations (LC-04)")
        print("  denies by cause: " + ("; ".join(causes) if causes else "none")
              + (f" · {safety['other_denies']} other" if safety["other_denies"] else ""))
        print(f"  approvals requested (SEC-07): {safety['approval_asks']}"
              + (f" · {safety['approval_fallbacks']} denied with 'the human must run it' (host cannot ask)" if safety["approval_fallbacks"] else ""))
        print(f"  worker activity: {safety['worker_roles']} uok-* roles seen · {safety['worker_decisions']} worker decisions")
    print()
    print("Context graph (Graphify, community integration)")
    if g.get("enabled") and g.get("nodes") is not None:
        print(f"  enabled: true · cli {g.get('cli_version', '?')} · {g['nodes']} nodes"
              + (f" · {g.get('edges', '?')} edges" if g.get("edges") is not None else "")
              + f" · schema {g.get('schema_version', '?')}")
        print(f"  built_at: {g.get('built_at', '?')} · verification: {g.get('verification', '?')} · mode: {g.get('mode', '?')}")
        if "fresh" in g:
            print(f"  freshness (CG-03): {'fresh' if g['fresh'] == 'yes' else 'STALE — run `graphify update .` before relying on claims'}")
    else:
        print("  not enabled (or not built) — the kit works without it (fail-open, degraded_context_graph)")
    print()
    print("Orchestration ledger")
    print(f"  routing decisions recorded: {ledger['routing_records']}"
          + (" (live sessions route per ROUTING-POLICY.md; nothing persisted yet)" if not ledger["routing_records"] else ""))
    print(f"  task ledger entries: {ledger['task_ledger_entries']} · audit notes: {ledger['audit_notes']}"
          f" · active claims: {ledger['active_claims']}")
    print(f"  registry: {report['registry_projects']} project(s) recorded in ~/.uok/projects.json")
    print()
    print("Not measured (honesty):")
    for line in report["not_measured"]:
        print(f"  - {line}")
    return 0


def main():
    ap = argparse.ArgumentParser(prog="uok", description=__doc__.strip().splitlines()[0])
    ap.add_argument("--version", action="version", version=f"uok release {release_version()} (kit spec {KIT_VERSION})")
    sub = ap.add_subparsers(dest="cmd", required=True)
    pi = sub.add_parser("init", help="install the kit into a project (primary installation path)")
    pi.add_argument("--host", choices=("auto",) + HOSTS + tuple(ADAPTER_ALIAS), default="auto")
    pi.add_argument("--project", default=None, help="project root (default: current directory)")
    pi.add_argument("--mode", choices=("standard", "strict"), default="standard")
    pi.add_argument("--models", default="", help="tier1=,tier2=,tier3=,review= selectors for the host")
    pi.add_argument("--graphify", choices=("auto", "install", "off"), default="auto",
                    help="Graphify context graph: auto=use CLI if on PATH (no network), install=also fetch via uv/pipx, off=skip")
    pi.add_argument("--dry-run", action="store_true")
    pr = sub.add_parser("refresh", help="re-apply the kit to every project recorded by init")
    pr.add_argument("--dry-run", action="store_true")
    pst = sub.add_parser("stats", help="per-project statistics: G1 safety, context graph, ledgers")
    pst.add_argument("--project", default=None, help="project root (default: current directory)")
    pst.add_argument("--json", action="store_true", help="machine-readable JSON instead of text")
    sub.add_parser("locate", help="record this kit folder in ~/.uok/location (run after moving the kit)")
    pb = sub.add_parser("bootstrap", help="register the user-level uok-init skill (once per machine)")
    pb.add_argument("--host", choices=("auto", "all") + HOSTS, default="auto")
    pb.add_argument("--dry-run", action="store_true")
    a = ap.parse_args()
    maybe_notice_update()
    if a.cmd == "locate":
        sys.exit(cmd_locate(a))
    if a.cmd == "stats":
        sys.exit(cmd_stats(a))
    if a.cmd == "refresh":
        sys.exit(cmd_refresh(a))
    sys.exit(cmd_init(a) if a.cmd == "init" else cmd_bootstrap(a))


if __name__ == "__main__":
    main()